{
  "name": "gm-mcp",
  "version": "0.2.2",
  "description": "MCP server exposing gm's spool dispatch cycle (write, poll, cleaned response) to any MCP client",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "gm-mcp": "bin/gm-mcp-server.js"
  },
  "files": [
    "src/",
    "bin/"
  ],
  "scripts": {
    "build": "esbuild src/cli.js --bundle --platform=node --format=esm --outfile=bin/gm-mcp-server.js --external:node:* --preserve-symlinks --banner:js=\"#!/usr/bin/env node\"",
    "verify-build": "node scripts/check-bin-drift.mjs",
    "test": "node test/response-compact.test.mjs && node test/runner-recovery.test.mjs",
    "postinstall": "node scripts/install-hooks.mjs"
  },
  "dependencies": {},
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "esbuild": "^0.28.2",
    "js-yaml": "^5.4.1",
    "zod": "^4.4.3"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AnEntrypoint/gm-mcp.git"
  },
  "author": "AnEntrypoint",
  "license": "MIT"
}
